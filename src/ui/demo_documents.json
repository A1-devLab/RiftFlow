  {
    "doc_id": "ddragon:rune:8010:16.18.1",
    "kind": "rune",
    "entity_id": "8010",
    "version": "16.18.1",
    "subject_name": "정복자",
    "title": "정복자 - 정밀 핵심",
    "source_url": "https://ddragon.leagueoflegends.com/cdn/16.18.1/data/ko_KR/runesReforged.json",
    "text": "적 챔피언에게 기본 공격 또는 스킬로 피해를 입히면 5초 동안 정복자 중첩을 2만큼 얻어 중첩마다 1.8~4의 적응형 능력치를 얻습니다. 최대 12회까지 중첩됩니다. 원거리 챔피언은 기본 공격으로 중첩을 1만 획득할 수 있습니다.\n최대로 중첩되면 챔피언에게 입힌 피해량의 8%만큼 체력을 회복합니다. (원거리 챔피언은 5%)",
    "fields": {
      "tree_id": 8000,
      "tree_name": "정밀",
      "slot": "핵심",
      "rune_key": "Conqueror"
    },
    "situation_tags": [
      "지속교전",
      "장기전",
      "브루저"
    ],
    "content_hash": "cfe3a3f4cf41fde4f92bcb55b5b5fd316309fa9b85dd6accf27598d2ca9c9716",
