# 서버에서 ~/riftflow/server.env 로 복사한 뒤 값을 채운다. chmod 600 으로 본인만 읽게 한다.
# 이 파일(예시)에는 실제 키를 적지 않는다.
RIOT_API_KEY=
RIFTFLOW_DB_PATH=/home/server/riftflow/data/server.db
# Personal 키 한도보다 조금 낮게. Production 키로 바꾸면 480/10,29000/600
RIFTFLOW_RIOT_LIMITS=18/1,90/120
RIFTFLOW_DEVICE_DAILY_REQUESTS=300
RIFTFLOW_DEVICE_CREATIONS_PER_HOUR=5
# AI (서버 2단계). 키가 비어 있으면 AI 기능은 '사용할 수 없음'으로 응답한다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# AI는 HASA(OpenAI 호환)만 쓴다. 키는 쉼표로 여러 개 (내 키, 팀원 키) - deploy/set_key.py HASA_API_KEY --add
LLM_PROVIDER=hasa
HASA_API_KEY=
# 쉼표로 순서를 정한다. 앞 모델을 어느 키로도 쓸 수 없으면 다음 모델.
HASA_MODEL=nemotron-super-120b
# gemini로 두면 HASA가 실패할 때 Gemini(GEMINI_API_KEY)로 넘긴다. 비우면 넘기지 않는다.
LLM_FALLBACK=
RIFTFLOW_KNOWLEDGE_DB=/home/server/riftflow/data/riftflow.db
RIFTFLOW_DEVICE_DAILY_AI=40
# 기기 토큰은 새로 받기 쉬워서 IP·서버 전체 한도를 함께 둔다. 동시 AI 요청 수(넘으면 바로 잠시 뒤 다시).
RIFTFLOW_IP_DAILY_AI=150
RIFTFLOW_GLOBAL_DAILY_AI=1500
RIFTFLOW_AI_CONCURRENCY=4
# 상위 랭커 빌드 통계 수집 (riftflow-builds.timer, 새벽 3시 30분). API와 같은 라이엇 키라 한도를 낮게 둔다.
RIFTFLOW_BUILD_LIMITS=5/1,40/120
RIFTFLOW_BUILD_PLAYERS=300
RIFTFLOW_BUILD_MATCHES=900
